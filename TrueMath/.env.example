# TrueMath runtime overrides
# Copy to `.env` or set these vars in your shell / installer.

# App data root. In packaged builds default is %LOCALAPPDATA%\TrueMath
# TRUEMATH_APP_HOME=C:\Users\<user>\AppData\Local\TrueMath

# Explicit mutable paths
# TRUEMATH_LOG_DIR=C:\Users\<user>\AppData\Local\TrueMath\logs
# TRUEMATH_STATE_DB_PATH=C:\Users\<user>\AppData\Local\TrueMath\data\truemath_state.db
# TRUEMATH_GRAVEYARD_DB_PATH=C:\Users\<user>\AppData\Local\TrueMath\data\truemath_graveyard.db

# Frontend assets
# TRUEMATH_DASHBOARD_ASSET_DIR=C:\Program Files\TrueMath\ui\dist

# Cloud LLM providers (Groq tried first, OpenRouter as fallback).
# Runs in the cloud — no local model, no PC hang. Get free keys at:
#   Groq:       https://console.groq.com/keys
#   OpenRouter: https://openrouter.ai/keys
TRUEMATH_GROQ_API_KEY=
TRUEMATH_GROQ_MODEL_NAME=openai/gpt-oss-120b
# TRUEMATH_GROQ_BASE_URL=https://api.groq.com/openai/v1/chat/completions

TRUEMATH_OPENROUTER_API_KEY=
TRUEMATH_OPENROUTER_MODEL_NAME=deepseek/deepseek-chat
# TRUEMATH_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions

# TRUEMATH_LLM_TIMEOUT_S=20

# Lean 4 formal verification (optional).
# Pure-integer expressions work automatically once Lean 4 is installed
# (https://leanprover-community.github.io/get_started.html) — no extra
# config needed. For trig/exp/log/pi expressions, run
# .\scripts\setup-lean4.ps1 once (heavy: downloads/builds Mathlib), then
# uncomment and set this to the path it prints at the end:
# TRUEMATH_LEAN4_PROJECT_DIR=C:\path\to\TrueMath\lean4_project

# Local service bindings
# TRUEMATH_IPC_HOST=127.0.0.1
# TRUEMATH_IPC_PORT=9999
# TRUEMATH_DASHBOARD_HOST=127.0.0.1
# TRUEMATH_DASHBOARD_PORT=8080

# Desktop shell
# TRUEMATH_DESKTOP_MODE=true
# TRUEMATH_DESKTOP_WIDTH=1440
# TRUEMATH_DESKTOP_HEIGHT=920
# TRUEMATH_DESKTOP_DEBUG=false

# Engine tuning
# TRUEMATH_LEAN4_TIMEOUT_S=30
# TRUEMATH_FALSIFICATION_ITERATIONS=1000
# TRUEMATH_MCTS_EXPLORATION_WEIGHT=1.41
# TRUEMATH_GENESIS_PATTERN_THRESHOLD=3
# TRUEMATH_SWARM_PORT=55444
# TRUEMATH_SWARM_BROADCAST_INTERVAL=5
# TRUEMATH_COGNITIVE_MAX_TOKENS=8192
